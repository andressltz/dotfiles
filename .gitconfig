[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[user]
	name = Ândres Schultz
	email = andres@domain.com.br
[alias]
	co = checkout
	st = status
	br = !sh -c 'git checkout -b $1' -
	brd = branch -d
	# br = !sh -c 'git branch $1 && git checkout $1' -
	# brd = !sh -c 'git branch -D $1 && git branch' -
# alias to clean
	limpa = !sh -c 'git fetch --prune && git remote update --prune' -
	rem = !sh -c 'git reset HEAD $1 && git status' -
	resethard = reset --hard HEAD
	cherry = !sh -c 'git cherry-pick $1' -
# alias to log
	logg = log --graph --date=short --pretty=format:'%Cred%h %Cblue%ad%Creset |%C(yellow)%d%Creset %s %Cblue[%an]'
	lg = log --pretty=format:"%h - %an, %ar : %s"
	last = log -1 HEAD
# tools
	web-gitlab = "!open \"$(git remote get-url origin | sed -E 's#ssh://git@([^:/]+)(:[0-9]+)?/#https://\\1/#; s#\\.git$##')\""
	web-github = "!open \"$(git remote get-url origin | sed -E 's#git@([^:]+):#https://\\1/#; s#ssh://git@([^:/]+)(:[0-9]+)?/#https://\\1/#; s#\\.git$##')\""
[core]
	pager = diff-so-fancy | less --tabs=4 -RFX
	excludesfile = ~/.gitignore
# Linux
	editor = nano
# Windows
	# editor = \"C:\\Users\\andreswinck\\AppData\\Local\\Programs\\Microsoft VS Code\\bin\\code\" --wait
# macOS
	# editor = mate --wait
	# editor = code --wait
[color]
	ui = true
[color "diff"]
	meta = 11
	commit = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
	func = 146 bold
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[push]
	autoSetupRemote = true
[pull]
	rebase = false

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[user]
	name = Ândres Winck Schultz
	email = andreswinck@domain.com.br
[alias]
	co = checkout
	br = !sh -c 'git branch $1 && git checkout $1' -
	brd = !sh -c 'git branch -D $1 && git branch' -
	limpa0 = git fetch --prune
	limpa1 = remote update --prune
	limpa2 = git branch -vv | grep 'gone]' | awk '{print $1}' | xargs git branch -D
	rem = !sh -c 'git reset HEAD $1 && git status' -
	logg = log --graph --date=short --pretty=format:'%Cred%h %Cblue%ad%Creset |%C(yellow)%d%Creset %s %Cblue[%an]'
	res = reset --hard HEAD
	cp = !sh -c 'git cherry-pick $1' -
	web-gitlab = "!open \"$(git remote get-url origin | sed -E 's#ssh://git@([^:/]+)(:[0-9]+)?/#https://\\1/#; s#\\.git$##')\""
	web-github = "!open \"$(git remote get-url origin | sed -E 's#git@([^:]+):#https://\\1/#; s#ssh://git@([^:/]+)(:[0-9]+)?/#https://\\1/#; s#\\.git$##')\""
[core]
	editor = nano
	# editor = mate -w
	# editor = subl -n -w
	# editor = code --wait
	pager = diff-so-fancy | less --tabs=4 -RFX
	excludesfile = ~/.gitignore
[color]
	ui = true
[color "diff"]
	meta = 11
	commit = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
	func = 146 bold
[interactive]
	diffFilter = diff-so-fancy --patch
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[push]
	autoSetupRemote = true
